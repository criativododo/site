{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": { "react": ["../app/node_modules/react"], "react/*": ["../app/node_modules/react/*"] },
    "typeRoots": ["../app/node_modules/@types"]
  },
  "include": ["src/components/index.tsx"]
}
