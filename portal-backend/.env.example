# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Persistência (Fase 2 do Plano Mestre, ADR-015) — PostgreSQL real, substitui o
# armazenamento em memória. Rodar `npm run db:migrate` antes do primeiro start.
DATABASE_URL=postgresql://localhost:5432/portal_dodo_dev

# Sessão (RN-18: sessão deslizante de 6h) — segredo usado para assinar o cookie de sessão.
# Gerar um valor aleatório forte antes de qualquer deploy (nunca reaproveitar este exemplo).
SESSION_SECRET=troque-este-valor-por-um-segredo-forte-antes-de-rodar

# Google OIDC (ADR-007) — provisionar em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI deve ser exatamente GOOGLE_REDIRECT_URI abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Bootstrap do primeiro Administrador (RN-07/SPEC-035): e-mails desta lista, separados por
# vírgula, viram Administrador ACTIVE automaticamente no primeiro login OIDC — mecanismo de
# provisionamento manual (o operador define este valor antes do primeiro deploy), não um
# fluxo de onboarding padrão.
ADMIN_BOOTSTRAP_EMAILS=

# Seed de desenvolvimento/QA (EPIC 2) — NÃO é o fluxo real de vinculação Identidade↔Parceira
# (SPEC-035 §5.1-A, ainda não implementado). Se preenchido, o primeiro login com este e-mail
# nasce ACTIVE e já vinculado a este parceiraId fixo, só para exercitar o Portal com dado
# real antes do fluxo de vinculação existir. Deixar vazio em produção.
PARCEIRA_SEED_EMAIL=
PARCEIRA_SEED_ID=
