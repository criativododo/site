# Template consolidado de variáveis de ambiente de PRODUÇÃO — Portal DODÔ.
#
# Este arquivo é referência/consolidação para o deploy na VPS; não substitui os arquivos
# de desenvolvimento já existentes (portal-backend/.env.example, portal-frontend/.env.example),
# que continuam valendo para ambiente local.
#
# Uso em produção:
#   cp deploy/.env.example portal-backend/.env    (preencher a seção BACKEND abaixo)
#   cp deploy/.env.example portal-frontend/.env   (preencher a seção FRONTEND abaixo)
# Nunca commitar os arquivos .env reais preenchidos.

# ============================================================
# BACKEND (portal-backend/.env) — lido por src/config/env.ts
# ============================================================

PORT=4000
NODE_ENV=production

# Origem(ns) do frontend autorizadas por CORS/cookie de sessão. Em produção, o domínio real
# por HTTPS (Nginx serve frontend e backend na mesma origem via /api e /auth — ver
# deploy/nginx.conf — então isto normalmente é o próprio domínio público).
FRONTEND_URL=https://SEU_DOMINIO_AQUI
FRONTEND_URLS=https://SEU_DOMINIO_AQUI

# Segredo de assinatura do cookie de sessão (RN-18: sessão deslizante de 6h).
# OBRIGATÓRIO gerar um valor novo e forte — nunca reaproveitar o do ambiente de dev.
# Gerar com: openssl rand -base64 48
SESSION_SECRET=

# Google OIDC (ADR-007) — credenciais do projeto de produção em
# https://console.cloud.google.com/apis/credentials (não reaproveitar credenciais de dev/teste).
# GOOGLE_REDIRECT_URI deve ser exatamente igual ao "Authorized redirect URI" cadastrado lá,
# e usar o domínio real de produção (não localhost, não o IP da VPS).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://SEU_DOMINIO_AQUI/auth/google/callback

# Bootstrap do primeiro Administrador (RN-07/SPEC-035) — e-mails separados por vírgula que
# nascem Administrador ACTIVE no primeiro login OIDC. Definir antes do primeiro deploy real;
# não é um mecanismo de onboarding contínuo.
ADMIN_BOOTSTRAP_EMAILS=

# Seed de desenvolvimento/QA — DEIXAR SEMPRE VAZIO EM PRODUÇÃO.
# (env.ts já zera estes campos quando NODE_ENV=production, mesmo que preenchidos aqui —
# mas manter vazio evita confusão operacional.)
PARCEIRA_SEED_EMAIL=
PARCEIRA_SEED_ID=

# --- Reservado para uso futuro — NÃO CONSUMIDO PELO CÓDIGO ATUAL ---
# portal-backend não tem nenhuma camada de acesso a banco de dados hoje: persistência é
# 100% em memória (decisão deliberada, ver START_HERE_NEXT_SESSION.md e
# docs/handoff/2026-07-27_backoffice-administrativo-consolidacao.md). O PostgreSQL 16
# instalado na VPS por este plano de deploy fica pronto para uma migração futura de
# persistência, mas nenhuma variável abaixo é lida por src/config/env.ts neste momento.
# Preencher só quando essa migração for decidida e implementada (ADR próprio, por regra
# deste projeto — não inventar essa decisão aqui).
# DATABASE_URL=postgresql://dodo_app:TROQUE_A_SENHA@127.0.0.1:5432/dodo_portal

# ============================================================
# FRONTEND (portal-frontend/.env) — lido por src/lib/api.ts e src/lib/session.tsx
# ============================================================

# Em produção, o Nginx serve o build estático do frontend e a API na MESMA origem
# (/api e /auth via proxy_pass — ver deploy/nginx.conf), então normalmente isto fica vazio
# (o frontend usa caminho relativo) OU aponta para o próprio domínio público.
VITE_API_BASE_URL=https://SEU_DOMINIO_AQUI
